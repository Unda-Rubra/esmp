<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- The bridge enables foreign_keys on the migration connection before update.
         This baseline neither changes PRAGMA user_version nor adopts existing tables. -->
    <preConditions onFail="HALT" onError="HALT">
        <dbms type="sqlite"/>
    </preConditions>
    <include file="db.changelog-baseline.xml" relativeToChangelogFile="true"/>
    <include file="phase2-certification.xml" relativeToChangelogFile="true"/>
    <include file="phase3-acquisition.xml" relativeToChangelogFile="true"/>
    <include file="phase4-local-activity.xml" relativeToChangelogFile="true"/>
    <include file="phase5-buildings.xml" relativeToChangelogFile="true"/>
    <include file="phase6-decay.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
