<column name="building_id" type="TEXT"><constraints nullable="false"/></column><column name="settlement_id" type="TEXT"><constraints nullable="false"/></column><column name="world_instance_id" type="TEXT"><constraints nullable="false"/></column><column name="actor_uuid" type="TEXT"><constraints nullable="false"/></column><column name="baseline_revision" type="INTEGER"><constraints nullable="false"/></column><column name="owner_uuid" type="TEXT"><constraints nullable="false"/></column><column name="ownership_revision" type="INTEGER"><constraints nullable="false"/></column><column name="chunk_revision" type="INTEGER"><constraints nullable="false"/></column><column name="security_revision" type="INTEGER"><constraints nullable="false"/></column>
